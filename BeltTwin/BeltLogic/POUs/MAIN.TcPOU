<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{14822338-0f92-4154-bb06-25c11b40a368}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // ---------------- exposed to OPC UA ----------------
    {attribute 'OPC.UA.DA' := '1'}
    eState          : E_ConveyorState := Stopped;
    {attribute 'OPC.UA.DA' := '1'}
    rSpeed          : REAL;
    {attribute 'OPC.UA.DA' := '1'}
    rSpeedRequest   : REAL := 80.0;
    {attribute 'OPC.UA.DA' := '1'}
    rPosition       : REAL;
    {attribute 'OPC.UA.DA' := '1'}
    bStartCmd       : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bStopCmd        : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bResetCmd       : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bFaultInject    : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bWearInject     : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bJamInject      : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bSlipInject     : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bOverloadInject : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    bMaintenanceCmd : BOOL;                 // NEW: clears bearing wear (Stopped/Faulted only)

    {attribute 'OPC.UA.DA' := '1'}
    nStartCount     : UDINT;
    {attribute 'OPC.UA.DA' := '1'}
    nStopCount      : UDINT;
    {attribute 'OPC.UA.DA' := '1'}
    nResetCount     : UDINT;
    {attribute 'OPC.UA.DA' := '1'}
    nFaultCount     : UDINT;                // CHANGED: counts every trip into Faulted
    {attribute 'OPC.UA.DA' := '1'}
    nMaintenanceCount : UDINT;              // NEW: counts performed maintenance actions
    {attribute 'OPC.UA.DA' := '1'}
    nPlcTime        : UDINT;
    {attribute 'OPC.UA.DA' := '1'}
    eFaultCode      : INT;

    // ---------------- sensors ----------------
    {attribute 'OPC.UA.DA' := '1'}
    rMotorCurrent   : REAL;
    {attribute 'OPC.UA.DA' := '1'}
    rMotorTemp      : REAL := 22.0;
    {attribute 'OPC.UA.DA' := '1'}
    rBearingTemp    : REAL := 22.0;
    {attribute 'OPC.UA.DA' := '1'}
    rVibration      : REAL;
    {attribute 'OPC.UA.DA' := '1'}
    rAmbientTemp    : REAL := 22.0;

    // ---------------- hidden internals ----------------
    rTargetSpeed    : REAL;
    rBeltSpeed      : REAL;
    rBearingWear    : REAL;
    rJamSeverity    : REAL;
    rSlipSeverity   : REAL;
    rOverloadLevel  : REAL;
    rWearRate       : REAL;
    rJamRate        : REAL;
    rSlipRate       : REAL;
    rOverloadRate   : REAL;
    rNoisePhase     : LREAL;                // CHANGED: LREAL, wraps at 20*pi
    rNoise          : REAL;

    rCurrentTarget  : REAL;
    rCurrentClean   : REAL;
    rMotorTarget    : REAL;
    rBearingTarget  : REAL;
    rMotorTempClean   : LREAL := 22.0;      // NEW: noise-free thermal state, LREAL (no float stall)
    rBearingTempClean : LREAL := 22.0;      // NEW

    // ---------------- pseudo-random noise ----------------
    nRng            : DWORD;                // xorshift32 state, seeded from clock on first scan
    rSum            : LREAL;
    aGauss          : ARRAY[0..3] OF REAL;  // 0 current, 1 vibration, 2 motor temp, 3 bearing temp
    i               : INT;
    j               : INT;
    nTrip           : INT;

    // ---------------- edge detection ----------------
    fbStartTrig     : R_TRIG;
    fbStopTrig      : R_TRIG;
    fbResetTrig     : R_TRIG;
    fbFaultTrig     : R_TRIG;
    fbWearTrig      : R_TRIG;
    fbJamTrig       : R_TRIG;
    fbSlipTrig      : R_TRIG;
    fbOverloadTrig  : R_TRIG;
    fbMaintTrig     : R_TRIG;               // NEW
    bStartEdge      : BOOL;
    bStopEdge       : BOOL;
    bResetEdge      : BOOL;
    bFaultEdge      : BOOL;
    bWearEdge       : BOOL;
    bJamEdge        : BOOL;
    bSlipEdge       : BOOL;
    bOverloadEdge   : BOOL;
    bMaintEdge      : BOOL;                 // NEW
END_VAR

VAR CONSTANT
    CYCLE_T         : REAL := 0.01;
    RAMP_PER_SCAN   : REAL := 0.5;
    POS_WRAP        : REAL := 1000.0;

    CUR_IDLE        : REAL := 2.0;
    CUR_PER_SPEED   : REAL := 0.0875;
    MOTOR_PER_SPEED : REAL := 0.5;
    BEAR_PER_SPEED  : REAL := 0.175;
    VIB_BASE        : REAL := 0.2;
    VIB_PER_SPEED   : REAL := 0.025;

    K_MOTOR         : REAL := 0.000167;
    K_BEARING       : REAL := 0.0000833;
    K_CURRENT       : REAL := 0.02;

    WEAR_RATE       : REAL := 0.00002;
    JAM_RATE        : REAL := 0.004;
    SLIP_RATE       : REAL := 0.0003;
    OVERLOAD_RATE   : REAL := 0.00015;
    FAULT_THRESHOLD : REAL := 0.8;

    // NEW: noise
    NOISE_WRAP      : LREAL := 62.83185307179586;  // 20*pi: both 3.7 and 11.3 rad/s complete whole cycles
    CUR_NOISE       : REAL := 0.04;     // A, std dev of random part
    VIB_NOISE       : REAL := 0.03;     // std dev
    TEMP_NOISE      : REAL := 0.1;      // degC, std dev (both temperature sensors)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ---------------- 0. housekeeping ----------------
nPlcTime := DWORD_TO_UDINT(TIME_TO_DWORD(TIME()));

// seed once from the clock so each PLC start gets a different noise sequence
IF nRng = 0 THEN
    nRng := TIME_TO_DWORD(TIME()) OR 16#00000001;
END_IF

// deterministic component; 20*pi wrap keeps both sines continuous
rNoisePhase := rNoisePhase + CYCLE_T;
IF rNoisePhase >= NOISE_WRAP THEN
    rNoisePhase := rNoisePhase - NOISE_WRAP;
END_IF
rNoise := LREAL_TO_REAL( SIN(rNoisePhase * 3.7) * 0.5
                       + SIN(rNoisePhase * 11.3) * 0.3 );

// random component: 4 independent ~N(0,1) samples (xorshift32, sum of 4 uniforms)
FOR i := 0 TO 3 DO
    rSum := 0.0;
    FOR j := 1 TO 4 DO
        nRng := nRng XOR SHL(nRng, 13);
        nRng := nRng XOR SHR(nRng, 17);
        nRng := nRng XOR SHL(nRng, 5);
        rSum := rSum + DWORD_TO_LREAL(nRng) / 4294967296.0;
    END_FOR
    aGauss[i] := LREAL_TO_REAL((rSum - 2.0) * 1.7320508);
END_FOR

// ---------------- 1. edge detection ----------------
fbStartTrig(CLK := bStartCmd);
fbStopTrig(CLK := bStopCmd);
fbResetTrig(CLK := bResetCmd);
fbFaultTrig(CLK := bFaultInject);
fbWearTrig(CLK := bWearInject);
fbJamTrig(CLK := bJamInject);
fbSlipTrig(CLK := bSlipInject);
fbOverloadTrig(CLK := bOverloadInject);
fbMaintTrig(CLK := bMaintenanceCmd);

bStartEdge    := fbStartTrig.Q;
bStopEdge     := fbStopTrig.Q;
bResetEdge    := fbResetTrig.Q;
bFaultEdge    := fbFaultTrig.Q;
bWearEdge     := fbWearTrig.Q;
bJamEdge      := fbJamTrig.Q;
bSlipEdge     := fbSlipTrig.Q;
bOverloadEdge := fbOverloadTrig.Q;
bMaintEdge    := fbMaintTrig.Q;

IF bStartEdge THEN nStartCount := nStartCount + 1; END_IF
IF bStopEdge  THEN nStopCount  := nStopCount  + 1; END_IF
IF bResetEdge THEN nResetCount := nResetCount + 1; END_IF
// nFaultCount is now incremented on every trip, in the Running state

IF bWearEdge     THEN rWearRate     := WEAR_RATE;     END_IF
IF bJamEdge      THEN rJamRate      := JAM_RATE;      END_IF
IF bSlipEdge     THEN rSlipRate     := SLIP_RATE;     END_IF
IF bOverloadEdge THEN rOverloadRate := OVERLOAD_RATE; END_IF

bStartCmd       := FALSE;
bStopCmd        := FALSE;
bResetCmd       := FALSE;
bFaultInject    := FALSE;
bWearInject     := FALSE;
bJamInject      := FALSE;
bSlipInject     := FALSE;
bOverloadInject := FALSE;
bMaintenanceCmd := FALSE;

// ---------------- 2. speed request -> target ----------------
IF rSpeedRequest > 80.0 THEN
    rTargetSpeed := 80.0;
ELSIF rSpeedRequest < 0.0 THEN
    rTargetSpeed := 0.0;
ELSE
    rTargetSpeed := rSpeedRequest;
END_IF

// ---------------- 3. fault accumulation ----------------
IF eState = Running THEN
    rBearingWear   := rBearingWear   + rWearRate;
    rJamSeverity   := rJamSeverity   + rJamRate;
    rSlipSeverity  := rSlipSeverity  + rSlipRate;
    rOverloadLevel := rOverloadLevel + rOverloadRate;
END_IF

IF rBearingWear   > 1.0 THEN rBearingWear   := 1.0; END_IF
IF rJamSeverity   > 1.0 THEN rJamSeverity   := 1.0; END_IF
IF rSlipSeverity  > 1.0 THEN rSlipSeverity  := 1.0; END_IF
IF rOverloadLevel > 1.0 THEN rOverloadLevel := 1.0; END_IF

// ---------------- 4. state machine ----------------
CASE eState OF

    Stopped:
        rSpeed := 0.0;
        IF bMaintEdge THEN
            rBearingWear      := 0.0;
            rWearRate         := 0.0;
            nMaintenanceCount := nMaintenanceCount + 1;
        END_IF
        IF bStartEdge THEN
            eFaultCode     := 0;
            // transient faults clear; bearing wear and its rate persist until maintenance
            rJamSeverity   := 0.0;
            rSlipSeverity  := 0.0;
            rOverloadLevel := 0.0;
            rJamRate       := 0.0;
            rSlipRate      := 0.0;
            rOverloadRate  := 0.0;
            eState := Starting;
        END_IF

    Starting:
        rSpeed := rSpeed + RAMP_PER_SCAN;
        IF rSpeed >= rTargetSpeed THEN
            rSpeed := rTargetSpeed;
            eState := Running;
        END_IF
        IF bStopEdge THEN
            eState := Stopped;
        END_IF

    Running:
        // CHANGED: ramp to setpoint instead of stepping (mid-run speed changes)
        IF rSpeed < rTargetSpeed - RAMP_PER_SCAN THEN
            rSpeed := rSpeed + RAMP_PER_SCAN;
        ELSIF rSpeed > rTargetSpeed + RAMP_PER_SCAN THEN
            rSpeed := rSpeed - RAMP_PER_SCAN;
        ELSE
            rSpeed := rTargetSpeed;
        END_IF

        nTrip := 0;
        IF bFaultEdge THEN
            nTrip := 5;
        ELSIF rJamSeverity >= FAULT_THRESHOLD THEN
            nTrip := 1;
        ELSIF rSlipSeverity >= FAULT_THRESHOLD THEN
            nTrip := 2;
        ELSIF rBearingWear >= FAULT_THRESHOLD THEN
            nTrip := 3;
        ELSIF rOverloadLevel >= FAULT_THRESHOLD THEN
            nTrip := 4;
        END_IF

        IF bStopEdge THEN
            eState := Stopped;
        ELSIF nTrip <> 0 THEN
            eFaultCode  := nTrip;
            nFaultCount := nFaultCount + 1;
            eState      := Faulted;
        END_IF

    Faulted:
        rSpeed := 0.0;
        IF bMaintEdge THEN
            rBearingWear      := 0.0;
            rWearRate         := 0.0;
            nMaintenanceCount := nMaintenanceCount + 1;
        END_IF
        IF bResetEdge THEN
            eFaultCode     := 0;
            // bearing wear is NOT cleared here: a worn bearing re-faults on Start
            rJamSeverity   := 0.0;
            rSlipSeverity  := 0.0;
            rOverloadLevel := 0.0;
            rJamRate       := 0.0;
            rSlipRate      := 0.0;
            rOverloadRate  := 0.0;
            eState := Stopped;
        END_IF

END_CASE

// ---------------- 5. belt kinematics ----------------
rBeltSpeed := rSpeed * (1.0 - rJamSeverity) * (1.0 - rSlipSeverity * 0.6);
IF rBeltSpeed < 0.0 THEN
    rBeltSpeed := 0.0;
END_IF

rPosition := rPosition + rBeltSpeed * CYCLE_T;
IF rPosition >= POS_WRAP THEN
    rPosition := rPosition - POS_WRAP;
END_IF

// ---------------- 6. sensor model ----------------
rCurrentTarget := CUR_IDLE
                + rSpeed * CUR_PER_SPEED
                + rJamSeverity * 14.0
                + rOverloadLevel * 6.0
                - rSlipSeverity * 1.5;

IF (eState = Stopped) OR (eState = Faulted) THEN
    rCurrentTarget := 0.0;
END_IF

rCurrentClean := rCurrentClean + (rCurrentTarget - rCurrentClean) * K_CURRENT;
IF (eState = Stopped) OR (eState = Faulted) THEN
    rMotorCurrent := rCurrentClean;     // motor off: smooth decay to 0, no rectified noise
ELSE
    rMotorCurrent := rCurrentClean + rNoise * 0.04 + aGauss[0] * CUR_NOISE;
END_IF
IF rMotorCurrent < 0.0 THEN
    rMotorCurrent := 0.0;
END_IF

rMotorTarget := rAmbientTemp
              + rSpeed * MOTOR_PER_SPEED
              + rOverloadLevel * 35.0
              + rJamSeverity * 10.0;

IF (eState = Stopped) OR (eState = Faulted) THEN
    rMotorTarget := rAmbientTemp;
END_IF

rMotorTempClean := rMotorTempClean + (rMotorTarget - rMotorTempClean) * K_MOTOR;
rMotorTemp      := LREAL_TO_REAL(rMotorTempClean) + aGauss[2] * TEMP_NOISE;

rBearingTarget := rAmbientTemp
                + rSpeed * BEAR_PER_SPEED
                + rBearingWear * 28.0
                + rSlipSeverity * 8.0;

IF (eState = Stopped) OR (eState = Faulted) THEN
    rBearingTarget := rAmbientTemp;
END_IF

rBearingTempClean := rBearingTempClean + (rBearingTarget - rBearingTempClean) * K_BEARING;
rBearingTemp      := LREAL_TO_REAL(rBearingTempClean) + aGauss[3] * TEMP_NOISE;

rVibration := VIB_BASE
            + rSpeed * VIB_PER_SPEED
            + rBearingWear * 4.5
            + rJamSeverity * 7.0
            + rSlipSeverity * 2.5
            + rOverloadLevel * 1.2;

IF (eState = Stopped) OR (eState = Faulted) THEN
    rVibration := 0.0;
ELSE
    rVibration := rVibration + rNoise * 0.04 + aGauss[1] * VIB_NOISE;
END_IF

IF rVibration < 0.0 THEN
    rVibration := 0.0;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>