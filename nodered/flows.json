    {
        "id": "4e656994d52b16fd",
        "type": "function",
        "z": "e7401aff17ad778e",
        "name": "fan-out",
        "func": "const vars = [\n  \"eState\",\"rSpeed\",\"rSpeedRequest\",\"rPosition\",\n  \"bStartCmd\",\"bStopCmd\",\"bResetCmd\",\"bFaultInject\",\n  \"bWearInject\",\"bJamInject\",\"bSlipInject\",\"bOverloadInject\",\n  \"nStartCount\",\"nStopCount\",\"nResetCount\",\"nFaultCount\",\n  \"nPlcTime\",\"eFaultCode\",\n  \"rMotorCurrent\",\"rMotorTemp\",\"rBearingTemp\",\"rVibration\",\"rAmbientTemp\"\n];\nflow.set(\"vars\", vars);\n   return [vars.map(v => ({ topic: \"ns=4;s=MAIN.\" + v }))];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
