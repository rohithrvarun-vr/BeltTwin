    {
        "id": "3d4c764f583a6297",
        "type": "function",
        "z": "e7401aff17ad778e",
        "name": "csv row",
        "func": "const d = JSON.parse(msg.payload);\nconst prev = flow.get(\"lastPlcTime\");\nif (d.nPlcTime === prev) return null;        // drop duplicate samples\nflow.set(\"lastPlcTime\", d.nPlcTime);\n\nconst runId = flow.get(\"runId\") || \"unset\";\nconst cols = [\"ts\", \"nPlcTime\", \"eState\", \"eFaultCode\", \"rSpeed\", \"rSpeedRequest\", \"rPosition\",\n    \"rMotorCurrent\", \"rMotorTemp\", \"rBearingTemp\", \"rVibration\", \"rAmbientTemp\",\n    \"nStartCount\", \"nStopCount\", \"nResetCount\", \"nFaultCount\"];\n\nif (!flow.get(\"headerWritten:\" + runId)) {\n    flow.set(\"headerWritten:\" + runId, true);\n    msg.payload = \"run_id,\" + cols.join(\",\") + \"\\n\" +\n        runId + \",\" + cols.map(c => d[c]).join(\",\") + \"\\n\";\n} else {\n    msg.payload = runId + \",\" + cols.map(c => d[c]).join(\",\") + \"\\n\";\n}\nmsg.filename = \"C:\\\\Users\\\\varun\\\\Documents\\\\TcXaeShell\\\\BeltTwin\\\\data\\\\\" + runId + \".csv\";\nreturn msg;",
