    {
        "id": "4a6e09ca62c67966",
        "type": "function",
        "z": "e7401aff17ad778e",
        "name": "cache",
        "func": "const t = String(msg.topic || \"\");\nconst i = t.indexOf(\"MAIN.\");\nif (i < 0) { node.status({fill:\"red\",shape:\"ring\",text:\"no MAIN in: \" + t}); return null; }\nconst name = t.slice(i + 5);\nif (msg.payload === null || msg.payload === undefined) { node.status({fill:\"yellow\",shape:\"ring\",text:\"null \" + name}); return null; }\nconst c = flow.get(\"cache\") || {};\nc[name] = msg.payload;\nflow.set(\"cache\", c);\nif (name === \"nPlcTime\" || name === \"rPosition\" || name === \"rMotorCurrent\") flow.set(\"lastUpdate\", Date.now());\nnode.status({fill:\"green\",shape:\"dot\",text:name});\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 200,
        "wires": [
            []
        ]
    },
    {
        "id": "38396b1a2323950b",
        "type": "function",
        "z": "e7401aff17ad778e",
        "name": "build json",
        "func": "const vars = flow.get(\"vars\") || [];\nconst cache = flow.get(\"cache\") || {};\nconst last = flow.get(\"lastUpdate\") || 0;\n\nconst missing = vars.filter(v => !(v in cache));\nif (missing.length) { node.status({fill:\"yellow\",shape:\"ring\",text:\"missing: \" + missing.join(\",\")}); return null; }\nif (Date.now() - last > 2000) { node.status({fill:\"red\",shape:\"ring\",text:\"stale\"}); return null; }\n\nconst data = { ts: Date.now() };\nfor (const v of vars) data[v] = cache[v];\nnode.status({fill:\"green\",shape:\"dot\",text:\"publishing\"});\nreturn { topic: \"conveyor2/telemetry\", payload: JSON.stringify(data) };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
