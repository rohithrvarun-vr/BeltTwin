    {
        "id": "58ffbe44f04c1f57",
        "type": "function",
        "z": "e7401aff17ad778e",
        "name": "cmd to opcua",
        "func": "// Whitelist: only these commands can reach the PLC\nconst map = {\n    start:    \"bStartCmd\",\n    stop:     \"bStopCmd\",\n    reset:    \"bResetCmd\",\n    fault:    \"bFaultInject\",\n    jam:      \"bJamInject\",\n    slip:     \"bSlipInject\",\n    overload: \"bOverloadInject\",\n    wear:     \"bWearInject\"\n};\n\nlet p = msg.payload;\nif (Buffer.isBuffer(p)) p = p.toString();\nif (typeof p === \"string\") {\n    try { p = JSON.parse(p); } catch (e) { p = { cmd: p.trim() }; }  // accept plain \"start\"\n}\n\nconst cmd = p && String(p.cmd).toLowerCase();\nconst v = map[cmd];\nif (!v) { node.warn(\"rejected command: \" + JSON.stringify(p)); return null; }\n\nnode.status({fill:\"blue\",shape:\"dot\",text:cmd});\nreturn {\n    topic: \"ns=4;s=MAIN.\" + v + \";datatype=Boolean\",\n    payload: true\n};",
